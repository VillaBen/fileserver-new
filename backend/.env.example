
# FileCloud 环境配置示例
# 复制此文件为 .env 并根据需要修改配置

# ==============================================
# 服务器配置
# ==============================================
PORT=3000
NODE_ENV=development

# ==============================================
# Session &amp; 安全配置
# ==============================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
SESSION_SECRET=your-super-secret-session-key-change-in-production
COOKIE_SECRET=your-super-secret-cookie-key-change-in-production

# ==============================================
# 数据库配置
# ==============================================
# 数据库类型: sqlite (默认) 或 mysql
DB_TYPE=sqlite

# SQLite 配置
DB_PATH=./database/fileserver.db

# MySQL 配置 (仅在 DB_TYPE=mysql 时生效)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=fileserver

# ==============================================
# 邮件配置 (用于密码重置等)
# ==============================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@example.com

# ==============================================
# 恶意文件检测配置
# ==============================================
# 检测模式: clamav | file-header | hybrid | virustotal | multi-scan | disabled
#  - file-header: 仅基于文件头和扩展名快速检测（默认，无需额外依赖）
#  - clamav: 使用 ClamAV 杀毒引擎（需要安装 ClamAV）
#  - hybrid: 文件头检测 + ClamAV 混合模式
#  - virustotal: 使用 VirusTotal 云端扫描（需要 API Key）
#  - multi-scan: 多引擎扫描（文件头 + ClamAV + VirusTotal，配置了就用）
#  - disabled: 完全关闭检测
MALWARE_SCAN_MODE=file-header

# 检测失败时是否阻止上传
BLOCK_ON_FAILURE=false

# ==============================================
# ClamAV 配置 (仅在 scanMode 为 clamav/hybrid/multi-scan 时生效)
# ==============================================
# ClamAV 本地扫描配置 (使用 clamdscan)
CLAMAV_SOCKET=/var/run/clamav/clamd.ctl
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=60000

# 是否自动移除感染文件
CLAMAV_REMOVE_INFECTED=false

# 是否隔离感染文件
CLAMAV_QUARANTINE_INFECTED=false
CLAMAV_QUARANTINE_PATH=./quarantine

# ==============================================
# VirusTotal 配置 (仅在 scanMode 为 virustotal/multi-scan 时生效)
# ==============================================
# VirusTotal API Key (在 https://www.virustotal.com/gui/join-us 申请)
VIRUSTOTAL_API_KEY=your-virustotal-api-key-here

# VirusTotal API 地址
VIRUSTOTAL_API_URL=https://www.virustotal.com/api/v3

# 请求超时时间 (毫秒)
VIRUSTOTAL_TIMEOUT=120000

# 是否在上传前先检查文件哈希（推荐 true，节省 API 调用）
VIRUSTOTAL_CHECK_HASH_FIRST=true

# 恶意检测阈值：当有 N 个引擎检测为恶意时标记为感染
VIRUSTOTAL_THRESHOLD=1

# 是否等待 VirusTotal 分析完成（true：等待，false：提交后立即返回）
# 注意：等待分析可能需要数分钟
VIRUSTOTAL_WAIT=false

# VirusTotal 分析等待超时时间 (毫秒)
VIRUSTOTAL_ANALYSIS_TIMEOUT=300000

# VirusTotal 分析检查间隔 (毫秒)
VIRUSTOTAL_CHECK_INTERVAL=5000

# ==============================================
# 其他配置
# ==============================================
# 文件大小限制 (字节)
MAX_FILE_SIZE=104857600

# 头像大小限制 (字节)
MAX_AVATAR_SIZE=5242880

# ==============================================
# 回收站自动删除配置
# ==============================================
TRASH_AUTO_DELETE_ENABLED=false
TRASH_AUTO_DELETE_DAYS=30

