
# FileCloud 环境配置示例
# 复制此文件为 .env 并根据需要修改配置

# ==============================================
# 服务器配置
# ==============================================
PORT=3000
NODE_ENV=development

# ==============================================
# Session &amp; 安全配置
# ==============================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
SESSION_SECRET=your-super-secret-session-key-change-in-production
COOKIE_SECRET=your-super-secret-cookie-key-change-in-production

# ==============================================
# 数据库配置
# ==============================================
DB_PATH=./database/fileserver.db

# ==============================================
# 邮件配置 (用于密码重置等)
# ==============================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@example.com

# ==============================================
# 恶意文件检测配置
# ==============================================
# 检测模式: clamav | file-header | hybrid | disabled
MALWARE_SCAN_MODE=hybrid

# 检测失败时是否阻止上传 (仅 hybrid 模式生效)
BLOCK_ON_FAILURE=false

# ==============================================
# ClamAV 配置 (仅在 scanMode 为 clamav/hybrid 时生效)
# ==============================================
# ClamAV 本地扫描配置 (使用 clamdscan)
CLAMAV_SOCKET=/var/run/clamav/clamd.ctl
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=60000

# 是否自动移除感染文件
CLAMAV_REMOVE_INFECTED=false

# 是否隔离感染文件
CLAMAV_QUARANTINE_INFECTED=false
CLAMAV_QUARANTINE_PATH=./quarantine

# ==============================================
# 其他配置
# ==============================================
# 文件大小限制 (字节)
MAX_FILE_SIZE=104857600

# 头像大小限制 (字节)
MAX_AVATAR_SIZE=5242880

# ==============================================
# 回收站自动删除配置
# ==============================================
TRASH_AUTO_DELETE_ENABLED=false
TRASH_AUTO_DELETE_DAYS=30

