# Server Configuration
PORT=3000
NODE_ENV=development
HTTPS=false

# Security Configuration (IMPORTANT: Change all these secrets in production!)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
SESSION_SECRET=your-super-secret-session-key-change-this-in-production
ENCRYPTION_SECRET=your-32-byte-encryption-key-change-this-in-production
CSRF_SECRET=your-csrf-secret-change-this-in-production

# Database Configuration
DB_PATH=./database/fileserver.db

# Storage Configuration
UPLOAD_DIR=./uploads/encrypted
AVATAR_DIR=./avatars
MAX_FILE_SIZE=104857600

# SMTP Configuration (optional, for email features)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com

# Session Configuration
SESSION_NAME=fileserver-sid
SESSION_AGE=86400000
