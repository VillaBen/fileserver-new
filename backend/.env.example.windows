# ============================================
# FileCloud 后端环境变量配置（Windows 专用）
# ============================================
# 复制此文件为 .env 后修改配置
# Windows 上的路径差异：
#   - MySQL 默认使用 TCP 连接（127.0.0.1:3306），不是 Unix Socket
#   - ClamAV 默认使用 TCP 连接（127.0.0.1:3310）或命令行，不是 Unix Socket
#   - Node.js 的 path.join() 会自动处理路径分隔符
# ============================================

# -------- 数据库配置 --------
# 可选值: sqlite | mysql
# Windows 推荐: sqlite（零配置，无需安装）
DB_TYPE=sqlite

# MySQL 配置（仅当 DB_TYPE=mysql 时需要）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=fileserver
# Windows 上 MySQL 使用 TCP 连接，不要设置下面这一行！
# MYSQL_SOCKET=/var/run/mysqld/mysqld.sock

# -------- 病毒扫描配置 --------
# 可选值: file-header | clamav | hybrid | virustotal | multi-scan | disabled
# Windows 推荐: file-header（零配置，无需安装）或 clamav（需安装）
MALWARE_SCAN_MODE=file-header

# ClamAV 配置（仅当 MALWARE_SCAN_MODE=clamav/hybrid 时需要）
# Windows 使用 TCP 连接或命令行，不要设置 CLAMAV_SOCKET
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=60000
CLAMAV_REMOVE_INFECTED=false
CLAMAV_QUARANTINE_INFECTED=false
CLAMAV_QUARANTINE_PATH=./quarantine

# 扫描失败时是否拒绝上传（严格模式）
BLOCK_ON_FAILURE=false

# -------- 服务端口配置 --------
# 后端服务端口
PORT=3000

# 允许的前端来源（CORS）
# 本地开发时 Vite 默认使用 5173
CORS_ORIGIN=http://localhost:5173

# -------- 安全配置 --------
# JWT 密钥（生成随机字符串，建议修改为你自己的随机值）
JWT_SECRET=filecloud_jwt_secret_change_this_to_a_long_random_string_32_chars_min

# 加密密钥（文件内容加密密钥）
ENCRYPTION_KEY=filecloud_encryption_key_change_this_to_at_least_32_characters

# CSRF 密钥
CSRF_SECRET=filecloud_csrf_secret_change_this_to_a_random_value

# Token 有效期（毫秒），4 小时 = 14400000
TOKEN_TTL=14400000

# -------- 文件上传配置 --------
# 单个文件最大大小（字节），100MB = 104857600
MAX_FILE_SIZE=104857600

# 文件存储路径（相对或绝对路径）
# Windows 路径示例: D:\\Files\\uploads 或 ./uploads
# 建议使用相对路径，便于项目管理
UPLOAD_PATH=./uploads
CACHE_PATH=./cache

# -------- 邮件配置（可选） --------
# 如需使用注册验证和密码重置，请配置 SMTP
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
# SMTP_FROM=FileCloud <your_email@gmail.com>

# -------- 开发配置 --------
# 是否启用详细日志（info | debug | warn | error）
LOG_LEVEL=info

# 开发模式（true 时显示详细错误信息）
NODE_ENV=development
